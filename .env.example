# Copy this file to .env and fill in the values. NEVER commit .env (it is already in .gitignore).

# ---- Flask / database (keep your existing values) ----
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=scmovs

# ---- Public address of the site, used inside password-reset emails ----
# Local testing:   http://localhost:5000
# Production:      https://your-real-domain   (use HTTPS; no trailing slash; do not use a temporary ngrok address)
PUBLIC_BASE_URL=http://localhost:5000

# ---- Gmail SMTP (password-reset emails) ----
# 1. Use a Google account for the system (for example scmovs.support@gmail.com).
# 2. Turn on 2-Step Verification:  https://myaccount.google.com/security
# 3. Create an App Password:       https://myaccount.google.com/apppasswords  (16 characters, no spaces)
# 4. Paste it below. Do NOT use the normal Gmail password: Google rejects it for SMTP.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=scmovs@gmail.com
MAIL_PASSWORD=ptnh ibsc chgy uynl
MAIL_SENDER=khenrodc@gmail.com

# Optional: password-reset rate limits (defaults shown)
# RESET_MAX_PER_IP=5
# RESET_MAX_PER_ACCOUNT=3
